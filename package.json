{
  "name": "the-tender-baron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm typecheck && pnpm test && pnpm test:coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
